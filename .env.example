OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

GITHUB_PERSONAL_ACCESS_TOKEN=your_default_github_pat
# Optional app-specific connector credentials can be referenced by
# app_connectors.credential_reference.
# Example: credential_reference="env:APP_A_GITHUB_PAT"
APP_A_GITHUB_PAT=your_app_a_github_pat
# 1 keeps GitHub MCP read-only. Use 0 only for intentional local write testing.
GITHUB_MCP_READ_ONLY=1

# Comma-separated browser origins allowed to call the FastAPI backend.
NEMO_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Management-webapp authentication. Replace with a random 32+ character value.
GMS_JWT_SECRET=replace-with-at-least-32-random-characters
GMS_JWT_EXPIRY_MINUTES=480

POSTGRES_DB=nemo_mcp_guardrails
POSTGRES_USER=nemo_mcp_guardrails
POSTGRES_PASSWORD=nemo_mcp_guardrails_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nemo_mcp_guardrails:nemo_mcp_guardrails_dev_password@localhost:5432/nemo_mcp_guardrails

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password
PGADMIN_PORT=5050

FINANCE_BOT_AZURE_KEY=your-real-key

GMS_JWT_SECRET=paste-generated-value-here
GMS_JWT_EXPIRY_MINUTES=480

NEMO_RUNTIME_DEBUG=1