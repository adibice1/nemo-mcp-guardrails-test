OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# Additional exact HTTPS origins approved for runtime LLMs, comma-separated.
# AZURE_OPENAI_ENDPOINT is automatically approved; restart after changes.
GMS_ALLOWED_LLM_ENDPOINTS=
# Additional exact LLM credential env names, comma-separated. The default
# AZURE_OPENAI_API_KEY name is automatically approved; restart after changes.
GMS_ALLOWED_LLM_CREDENTIAL_ENV_VARS=

GITHUB_PERSONAL_ACCESS_TOKEN=your_default_github_pat
# Additional exact GitHub credential env names, comma-separated. The default PAT
# above is automatically approved. Restart after changes; add APP_A_GITHUB_PAT
# here before using the example reference below.
GMS_ALLOWED_GITHUB_CREDENTIAL_ENV_VARS=
# Optional app-specific connector credentials can be referenced by
# app_connectors.credential_reference.
# Example: credential_reference="env:APP_A_GITHUB_PAT"
APP_A_GITHUB_PAT=your_app_a_github_pat
# 1 keeps GitHub MCP read-only. Use 0 only for intentional local write testing.
GITHUB_MCP_READ_ONLY=1

# Comma-separated browser origins allowed to call the FastAPI backend.
NEMO_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Management-webapp authentication. Replace with a random 32+ character value.
GMS_JWT_SECRET=replace-with-at-least-32-random-characters
GMS_JWT_EXPIRY_MINUTES=480

POSTGRES_DB=nemo_mcp_guardrails
POSTGRES_USER=nemo_mcp_guardrails
POSTGRES_PASSWORD=nemo_mcp_guardrails_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nemo_mcp_guardrails:nemo_mcp_guardrails_dev_password@localhost:5432/nemo_mcp_guardrails

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password
PGADMIN_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=80

FINANCE_BOT_AZURE_KEY=your-real-key

GMS_JWT_SECRET=paste-generated-value-here
GMS_JWT_EXPIRY_MINUTES=480

# Enable metadata-only debug responses for local troubleshooting.
NEMO_RUNTIME_DEBUG=0

# Reuse expensive per-app NeMo, agent, and MCP construction.
# Set the TTL to 0 to disable the cache while debugging.
NEMO_RUNTIME_CACHE_TTL_SECONDS=300
NEMO_RUNTIME_CACHE_MAX_APPS=32

# Exact compatible API base URLs (path included), separate from Azure origins.
# HTTPS for remote services; HTTP allowed only for explicitly approved literal
# 127.0.0.1 or [::1] endpoints. Example: https://llm-gateway.example.com/v1
GMS_ALLOWED_COMPATIBLE_LLM_ENDPOINTS=
# Provision a model-restricted gateway key privately; approve its env NAME in
# GMS_ALLOWED_LLM_CREDENTIAL_ENV_VARS. Profiles must explicitly reference it.
GMS_MODEL_GATEWAY_KEY=
# Independent policy-authoring profile; Azure remains the committed default.
# For compatible mode set all three values and backend approvals above.
GMS_POLICY_AI_PROVIDER=azure_openai
GMS_POLICY_AI_ENDPOINT=
GMS_POLICY_AI_MODEL=
GMS_POLICY_AI_CREDENTIAL_REFERENCE=

# Dedicated Fernet key for app-owned model API keys. Provision privately; never reuse JWT/provider keys.
# Keep a protected backup separate from database backups; losing it makes stored model keys unreadable.
GMS_MODEL_CREDENTIAL_ENCRYPTION_KEY=
