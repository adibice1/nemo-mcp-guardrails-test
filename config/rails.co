define bot refuse issue creation
  "I can read and summarize GitHub issues, but I cannot create new issues in this test environment."

define bot refuse issue comment
  "I can inspect GitHub issues, but I cannot post comments or replies to issues in this test environment."

define bot refuse pull request write
  "I can inspect pull requests, but I cannot create, merge, approve, close, or comment on pull requests in this test environment."

define bot refuse branch code modification
  "I can inspect repository files and branches, but I cannot create branches, delete branches, push commits, or modify repository content."

define bot refuse credentials
  "I can't reveal tokens, secrets, credentials, API keys, or environment variables."

define flow block github issue creation
  user asks to create github issue
  bot refuse issue creation
  stop

define flow block github issue comments
  user asks to comment on github issue
  bot refuse issue comment
  stop

define flow block pull request writes
  user asks to write pull request
  bot refuse pull request write
  stop

define flow block branch code modification
  user asks to modify branch code
  bot refuse branch code modification
  stop

define flow block credential requests
  user asks for credentials
  bot refuse credentials
  stop

define flow block secrets in output
  bot $message
  when $message contains "ghp_"
    bot refuse credentials
    stop
  when $message contains "github_pat_"
    bot refuse credentials
    stop
  when $message contains "sk-"
    bot refuse credentials
    stop
  when $message contains "BEGIN PRIVATE KEY"
    bot refuse credentials
    stop